{
  "hooks": {
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jutsu-mode\" expand", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jutsu-mode\" prompt", "timeout": 10 } ] }
    ],
    "SessionStart": [
      { "matcher": "resume|fork|compact", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jutsu-mode\" start", "timeout": 10 } ] }
    ]
  }
}
